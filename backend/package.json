{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:lambda": "bash scripts/package-lambda.sh",
    "dynamodb:up": "mkdir -p .dynamodb-data && chmod 777 .dynamodb-data && docker compose -f docker-compose.dynamodb.yml up -d",
    "dynamodb:down": "docker compose -f docker-compose.dynamodb.yml down",
    "dynamodb:setup-table": "bash scripts/create-local-sessions-table.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1119.0",
    "@aws-sdk/lib-dynamodb": "^3.1119.0",
    "@fastify/autoload": "^6.0.3",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/type-provider-typebox": "^5.0.1",
    "@sinclair/typebox": "^0.33.17",
    "aws-jwt-verify": "^4.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
