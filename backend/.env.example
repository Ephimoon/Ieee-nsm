# Local, untracked overrides layered on top of .env.defaults and
# .env.<NODE_ENV> (see src/config/env.ts). Copy this file to `.env` and
# fill in the secrets below — `.env` is gitignored.
#
# NODE_ENV selects which of .env.development / .env.production / .env.test
# gets layered in; set it in your shell or process manager, not here.
#
# This file (and .env) is only used for local dev/test. In production the
# app runs as a Lambda and reads env vars from the Lambda function's own
# configuration instead — see .env.production for details.

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signs the short-lived PKCE/state cookie used during the login redirect.
# Generate with: openssl rand -base64 48
COOKIE_SECRET=
