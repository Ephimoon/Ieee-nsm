# Local, untracked overrides layered on top of .env.defaults and
# .env.<NODE_ENV> (see src/config/env.ts). Copy this file to `.env` and
# fill in the secrets below — `.env` is gitignored.
#
# NODE_ENV selects which of .env.development / .env.production / .env.test
# gets layered in; set it in your shell or process manager, not here.
#
# This file (and .env) is only used for local dev/test. In production the
# app runs as a Lambda and reads env vars from the Lambda function's own
# configuration instead — see .env.production for details.

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signs the short-lived PKCE/state cookie used during the login redirect.
# Generate with: openssl rand -base64 48
COOKIE_SECRET=

# AWS account id used to build resource ARNs (e.g. DynamoDB table ARNs —
# see lib/arn.ts; region comes from AWS_REGION in .env.defaults). Table
# names themselves are code constants in config/tables.ts, not env vars,
# since they don't vary per environment. Create the tables ahead of time
# (see config/tables.ts for names) with partition key "sessionId" (String)
# and TTL enabled on "expiresAt" (Number, epoch seconds). The Lambda's
# execution role needs PutItem/GetItem/DeleteItem on the resulting table ARNs.
AWS_ACCOUNT_ID=
# Optional — defaults to 43200 (12 hours) if unset.
# SESSION_TTL_SECONDS=43200

# Optional. Only for local dev against DynamoDB Local (docker compose -f
# docker-compose.dynamodb.yml up) — leave unset otherwise. When set, tables
# are addressed by bare name instead of a real ARN (DynamoDB Local has no
# real accounts), so AWS_ACCOUNT_ID is required by config validation but
# unused in this mode — any placeholder value works, e.g. "000000000000".
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
