PORT=3001
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:3000

# AWS Cognito
COGNITO_REGION=us-east-2
# "access" or "id" - which token type incoming requests present
COGNITO_TOKEN_USE=access

# Region used to build resource ARNs (see lib/arn.ts). AWS_ACCOUNT_ID stays
# out of this file — it's account-identifying, so it belongs in the local
# untracked .env (or the Lambda's own env config in production).
AWS_REGION=us-east-2

# Cognito Hosted UI (OIDC login flow) — app client must be "confidential"
# (generate a client secret) since the code exchange happens server-side.
# Domain has no scheme, e.g. "my-app.auth.us-east-1.amazoncognito.com"
COGNITO_DOMAIN=login.ieee-cs.com
# Must exactly match a callback URL registered on the Cognito app client
OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
# Where the browser lands after login/logout completes (the SPA's origin)
APP_BASE_URL=http://localhost:3000
